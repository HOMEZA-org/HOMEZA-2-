# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK PAYMENT INTEGRATION (TEST & LIVE MODE)
# Keep PAYSTACK_SECRET_KEY server-side only in server.ts (e.g. sk_live_... or sk_test_...)
PAYSTACK_SECRET_KEY=""
# PAYSTACK_PUBLIC_KEY is passed to checkout clients (e.g. pk_live_... or pk_test_...)
PAYSTACK_PUBLIC_KEY=""
# PAYSTACK_WEBHOOK_SECRET is optional; defaults automatically to PAYSTACK_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=""
INSPECTION_FEE_AMOUNT="3000"

# LIVE BUSINESS EMAIL & DIRECT SMTP CONFIGURATION (Nodemailer / SMTP)
# Business mailbox: support@homeza.com.ng (GO54 / Whogohost)
# Host: smtp.go54mail.com (SSL direct on port 465)
# Username: support@homeza.com.ng
SMTP_HOST="smtp.go54mail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="support@homeza.com.ng"
SMTP_PASS=""
SMTP_FROM="HOMEZA Support <support@homeza.com.ng>"
SUPPORT_EMAIL="support@homeza.com.ng"

# HOMEZA IDENTITY & KYC VERIFICATION INTEGRATION (TEST / LIVE MODE)
# Provider choices: identifyorg, test-provider, prembly, youverify, dojah, smile-identity
VERIFICATION_PROVIDER="identifyorg"
# Mode: "test" (mock/sandbox with diagnostic test fixtures) or "live" (production API)
VERIFICATION_MODE="test"

# IdentifyOrg Test & Live Environment Secrets
# Server-side only, NEVER exposed in frontend code
IDENTIFYORG_DEFAULT_TEST_KEY=""
IDENTIFYORG_LIVE_KEY=""

# Optional Nigerian & Global SMS Delivery Gateways (for live cellular OTP delivery)
# Termii transactional DND route:
TERMII_API_KEY=""
# Twilio carrier delivery:
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Custom transactional SMS gateway / webhook URL:
SMS_API_URL=""
# SMS Sender ID (e.g. HOMEZA)
SMS_SENDER_ID="HOMEZA"

# Optional generic verification credentials
VERIFICATION_API_KEY=""
VERIFICATION_SECRET=""
PHONE_OTP_API_KEY=""

